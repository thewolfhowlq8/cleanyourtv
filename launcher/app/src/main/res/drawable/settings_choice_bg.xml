<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF384452" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="#FFE0E7EF" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF303D4B" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#FF9DAFBE" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF171D25" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#FF303A46" />
        </shape>
    </item>
</selector>
